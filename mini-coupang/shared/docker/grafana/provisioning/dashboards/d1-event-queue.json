{
  "uid": "mc-event-queue",
  "title": "미니쿠팡 · 인덱싱 이벤트 큐 (D1)",
  "tags": ["mini-coupang", "backend", "async"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "큐 적재 수 (productIndexingExecutor)",
      "description": "현재 대기 중인 태스크 수. 평상시 0 근처, 버스트 시 상승. 100 도달 시 CallerRunsPolicy 발동.",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "executor_queued_tasks{name=\"productIndexingExecutor\"}",
          "legendFormat": "queued"
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "활성 스레드 · 풀 크기",
      "description": "active는 실제 실행 중 스레드 수, pool은 현재 풀 크기. core=2, max=4.",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "executor_active_threads{name=\"productIndexingExecutor\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "executor_pool_size_threads{name=\"productIndexingExecutor\"}",
          "legendFormat": "pool size"
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "완료 처리 속도 (tasks/s)",
      "description": "completed counter의 1분 rate. 인덱싱 처리량.",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(executor_completed_tasks_total{name=\"productIndexingExecutor\"}[1m])",
          "legendFormat": "completed/s"
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "큐 여유",
      "description": "queue_remaining = capacity − queued. 0 도달 시 CallerRunsPolicy가 발행 스레드에 태스크를 떠넘김.",
      "gridPos": {"x": 12, "y": 10, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "executor_queue_remaining_tasks{name=\"productIndexingExecutor\"}",
          "legendFormat": "remaining"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "green", "value": 50}
            ]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "임베드 인덱싱 지연 (embed.index.latency)",
      "description": "AFTER_COMMIT 실행 직후 gRPC embed+upsert 소요. outcome=success 만 집계.",
      "gridPos": {"x": 18, "y": 10, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(embed_index_latency_seconds_bucket{outcome=\"success\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(embed_index_latency_seconds_bucket{outcome=\"success\"}[1m])))",
          "legendFormat": "p50"
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ]
}
