{
  "uid": "mc-indexing-e2e",
  "title": "미니쿠팡 · 상품 등록 → 검색 노출 지연 (D2)",
  "tags": ["mini-coupang", "backend", "async", "indexing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "구간별 p95 비교 (queue.wait · embed.index · e2e)",
      "description": "3구간을 한 축에 올려 누가 E2E를 지배하는지 한눈에.",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(product_indexing_queue_wait_seconds_bucket[1m])))",
          "legendFormat": "queue.wait p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(embed_index_latency_seconds_bucket{outcome=\"success\"}[1m])))",
          "legendFormat": "embed.index p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(product_indexing_e2e_seconds_bucket[1m])))",
          "legendFormat": "e2e p95"
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "E2E 지연 분위수 (p50 / p95 / p99)",
      "description": "이벤트 발행에서 Qdrant 반영까지 총 소요. 판매자 응답과 무관한 백그라운드 지연.",
      "gridPos": {"x": 0, "y": 10, "w": 16, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(product_indexing_e2e_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(product_indexing_e2e_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(product_indexing_e2e_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "인덱싱 실패율 (5m)",
      "description": "embed.index.latency{outcome=failure} / total. CallerRunsPolicy와 무관하게 ML 서비스 장애 감시.",
      "gridPos": {"x": 16, "y": 10, "w": 8, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(embed_index_latency_seconds_count{outcome=\"failure\"}[5m])) / clamp_min(sum(rate(embed_index_latency_seconds_count[5m])), 0.001)",
          "legendFormat": "failure rate"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      }
    }
  ]
}
