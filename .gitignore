# dependencies
node_modules/
.pnpm-store/

# build output
.next/
.velite/
out/
*.tsbuildinfo

# test artifacts
coverage/

# environment
.env
.env.local
.env*.local

# editor / OS
.DS_Store
*.log
.vscode/*
!.vscode/settings.json
.idea/
# Ignore .claude/ contents but allow skills/ to be tracked.
# Note: cannot use .claude/ (directory ignore) with nested exceptions — git
# won't descend into an ignored directory. Use per-entry patterns instead.
.claude/*
!.claude/skills/

# Allow project-local skills even though .claude/ is ignored.
# This keeps settings.local.json and other personal state ignored
# while making the blog-writer skill (and any future skills) trackable.
!.claude/skills/**

# Phase 5 search index — generated by scripts/generate-search-index.ts
/public/search-index.json
